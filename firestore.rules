rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users & Staff Profiles
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Classes & Student Rosters
    match /classes/{classId} {
      allow read, write: if isValidId(classId);
    }

    // Leave & Substitute Requests
    match /leaveRequests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Facility Proposals & Repairs
    match /facilityProposals/{proposalId} {
      allow read, write: if isValidId(proposalId);
    }

    // Internal Expenses & Payment Vouchers
    match /internalExpenses/{expenseId} {
      allow read, write: if isValidId(expenseId);
    }

    // 6-Stage Administrative Workflows
    match /workWorkflowItems/{workflowId} {
      allow read, write: if isValidId(workflowId);
    }

    // Student Transfers & Movement
    match /studentTransfers/{transferId} {
      allow read, write: if isValidId(transferId);
    }

    // Student Absences
    match /studentAbsences/{absenceId} {
      allow read, write: if isValidId(absenceId);
    }

    // Principal Private Cashbook
    match /cashbookEntries/{entryId} {
      allow read, write: if isValidId(entryId);
    }

    // Suggestion Box & Feedbacks
    match /feedbacks/{feedbackId} {
      allow read, write: if isValidId(feedbackId);
    }

    // Public Articles & Honors
    match /publicArticles/{articleId} {
      allow read, write: if isValidId(articleId);
    }

    // System Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Default Deny for other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
